# Copy to .env and adjust as needed. All values below are the defaults used if unset.

# --- Network ---
# Port the gateway (Caddy) publishes on the host. Accessible at http://localhost:HOST_PORT
# and http://<machine-ip>:HOST_PORT from other devices on the LAN.
HOST_PORT=8080

# Optional: require this token (sent as X-Access-Token header) for all API/WS requests.
# Leave empty to disable auth entirely (fine for a trusted local network; set it if you plan
# to expose this beyond your own LAN).
ACCESS_TOKEN=

# Comma-separated origins to allow via CORS. Leave empty — the gateway serves frontend and
# API from the same origin, so CORS is normally unnecessary.
CORS_ALLOW_ORIGINS=

# --- Uploads ---
# Max upload size in bytes. Default: 5 GiB.
MAX_UPLOAD_BYTES=5368709120

# --- Transcription (worker) ---
# cuda or cpu. `make up` (GPU profile) requires cuda; `make up-cpu` forces cpu regardless.
TRANSCRIPTION_DEVICE=cuda
# int8 | int8_float16 | float16 | float32 — lower precision = less VRAM, usually faster, but
# int8 kernels are unsupported on some newer GPU architectures (confirmed CUBLAS_STATUS_NOT_SUPPORTED
# on RTX 50-series/Blackwell). float16 is the safest default; the worker also falls back through
# other compute types automatically and logs each attempt if the requested one fails.
TRANSCRIPTION_COMPUTE_TYPE=float16
# small | medium | turbo | large-v3
DEFAULT_MODEL=turbo

# --- Logging ---
LOG_LEVEL=INFO
# AudioWhisper 2.0: only a local Ollama endpoint is used for intelligence.
OLLAMA_URL=http://host.docker.internal:11434
INSTALL_DIARIZATION=true
DIARIZATION_MODEL=pyannote/speaker-diarization-community-1
HF_TOKEN=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
