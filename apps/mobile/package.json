{
  "name": "audiowhisper-mobile",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "audit:dependencies": "node scripts/audit-dependencies.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/core.test.ts",
    "test:coverage": "node --experimental-strip-types --experimental-test-coverage --test --test-coverage-include=src/core/*.ts --test-coverage-lines=95 --test-coverage-branches=90 tests/core.test.ts",
    "prebuild:android": "expo prebuild --platform android --no-install",
    "build:android": "node scripts/build-android.mjs",
    "build:web": "expo export --platform web"
  },
  "dependencies": {
    "@expo-google-fonts/ibm-plex-sans": "^0.4.1",
    "@expo-google-fonts/manrope": "^0.4.2",
    "expo": "~55.0.32",
    "expo-build-properties": "~55.0.18",
    "expo-crypto": "~55.0.19",
    "expo-dev-client": "~55.0.41",
    "expo-document-picker": "~55.0.17",
    "expo-file-system": "~55.0.26",
    "expo-font": "~55.0.8",
    "expo-navigation-bar": "~55.0.17",
    "expo-network": "~55.0.18",
    "expo-router": "~55.0.18",
    "expo-secure-store": "~55.0.18",
    "expo-sharing": "~55.0.25",
    "expo-status-bar": "~55.0.6",
    "expo-system-ui": "~55.0.22",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^55.0.0",
    "typescript": "~5.9.2"
  },
  "private": true,
  "type": "module"
}
