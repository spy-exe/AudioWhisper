:8080 {
	encode gzip

	request_body {
		max_size 5GB
	}

	@ws path /ws/*
	handle @ws {
		reverse_proxy api:8000
	}

	@api path /api/*
	handle @api {
		reverse_proxy api:8000 {
			transport http {
				read_timeout 3600s
			}
		}
	}

	handle {
		reverse_proxy web:3000
	}

	log {
		output stdout
		format console
	}
}
